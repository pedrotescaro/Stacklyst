# ─────────────────────────────────────────────────────────────
# Stacklyst — Docker Environment Variables
# Copie para `.env.docker` e preencha com seus valores.
#
#   cp .env.docker.example .env.docker
#
# As variáveis DATABASE_URL e DIRECT_URL são injetadas
# automaticamente pelo docker-compose (apontando para o
# container PostgreSQL local). NÃO defina-as aqui.
# ─────────────────────────────────────────────────────────────

# ── Docker Postgres ──────────────────────────────────────────
# Senha usada pelo container PostgreSQL. O docker-compose usa
# este valor para criar o banco e montar a connection string.
DB_PASSWORD=postgres_stacklyst_2024

# ── Supabase Auth (OBRIGATÓRIO para login/registro) ─────────
# Crie um projeto gratuito em https://supabase.com e copie
# as credenciais de Settings > API.
# Sem essas chaves, o app sobe mas login/registro não funcionam.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Projetos legados também podem usar NEXT_PUBLIC_SUPABASE_ANON_KEY e
# SUPABASE_SERVICE_ROLE_KEY.

# ── JWT ──────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
# Ou no PowerShell: [System.Guid]::NewGuid().ToString("N") + [System.Guid]::NewGuid().ToString("N")
JWT_SECRET=troque_por_um_valor_seguro_de_64_caracteres_hex
JWT_EXPIRES_IN=7d

# ── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Endpoints Configuráveis ──────────────────────────────────
NEXT_PUBLIC_AVATAR_API_URL=https://api.dicebear.com/9.x/pixel-art/svg
PISTON_API_URL=https://emkc.org/api/v2/piston/execute

# ── Rate Limiting (opcional) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Seed (opcional — apenas se quiser popular o banco) ───────
# Senha mínima: 12 caracteres
SEED_DEFAULT_PASSWORD=Docker_Test_12345

# ── SSL (dev local) ─────────────────────────────────────────
SUPABASE_SSL_INSECURE=false

# ── GitHub (opcional) ───────────────────────────────────────
GITHUB_API_URL=https://api.github.com

# ── Cron (opcional) ─────────────────────────────────────────
CRON_SECRET=
