erDiagram
  User {
    String id PK
    String username
    String email
    String avatar_url
    Json avatar_config
    String bio
    String institution
    String github_username
    String discord_username
  }
  ProfileCustomization {
    String userId PK
    Json preferences
    Json chat
    Int version
    DateTime updatedAt
  }
  ProfileAchievementCatalog {
    String id PK
    Json value
    Int version
    DateTime updatedAt
  }
  UserProfileAchievement {
    String userId PK
    String achievementId PK
    Json definition
    DateTime unlockedAt
    DateTime announcedAt
  }
  LearningCredential {
    String id PK
    String userId FK
    String definitionId
    Int definitionVersion
    Json snapshot
    String integrityHash
    DateTime issuedAt
    DateTime verifiedAt
    DateTime revokedAt
  }
  Badge {
    String id PK
    String slug
    String label
    String description
    String icon
    String color
  }
  UserBadge {
    String id PK
    String user_id FK
    String badge_id FK
    DateTime earned_at
  }
  MobileState {
    String user_id PK
    String key PK
    Json value
    Int version
    DateTime updated_at
  }
  MobileDevice {
    String token PK
    String user_id FK
    Boolean enabled
    DateTime updated_at
  }
  SecurityAuditEvent {
    String id PK
    String actor_id
    String action
    String resource_id
    Json metadata
    DateTime created_at
    DateTime retain_until
  }
  User ||--o{ ProfileCustomization : "userId"
  User ||--o{ UserProfileAchievement : "userId"
  User ||--o{ LearningCredential : "userId"
  User ||--o{ UserBadge : "user_id"
  Badge ||--o{ UserBadge : "badge_id"
  User ||--o{ MobileState : "user_id"
  User ||--o{ MobileDevice : "user_id"
