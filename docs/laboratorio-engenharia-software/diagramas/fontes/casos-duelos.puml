@startuml
title Duelos e avaliação
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam nodesep 12
skinparam ranksep 35
actor "Usuário autenticado" as Usuario
actor Avaliador
actor Administrador
actor "Executor de código" as Runner
rectangle Stacklyst {
  usecase "UC029 Executar código\ne testes" as UC029
  usecase "UC008 Criar duelo aberto" as UC008
  usecase "UC009 Entrar em duelo" as UC009
  usecase "UC010 Enviar solução de duelo" as UC010
  usecase "UC016 Avaliar empate técnico" as UC016
  usecase "UC024 Candidatar-se a avaliador" as UC024
  usecase "UC027 Aprovar ou rejeitar candidatura de avaliador" as UC027
}
Usuario -- UC008
Usuario -- UC009
Usuario -- UC010
Usuario -- UC024
Runner -- UC029
Avaliador -- UC016
Administrador -- UC016
Administrador -- UC027
Avaliador --|> Usuario
Administrador --|> Usuario
UC010 ..> UC029 : <<include>>
@enduml
