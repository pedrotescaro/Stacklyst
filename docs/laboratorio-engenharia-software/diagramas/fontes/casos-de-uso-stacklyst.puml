@startuml
title Casos de uso implementados do Stacklyst
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam nodesep 18
skinparam ranksep 35
actor Visitante
actor "Usuário autenticado" as Usuario
actor Avaliador
actor Administrador
actor Recrutador
actor "Provedor de identidade" as Auth
actor "Executor de código" as Runner
rectangle Stacklyst {
 package "Conta e aprendizado" {
  usecase "UC001 Cadastrar conta" as UC001
  usecase "UC002 Fazer login" as UC002
  usecase "UC003 Editar perfil" as UC003
  usecase "UC004 Selecionar trilha" as UC004
  usecase "UC005 Estudar lição" as UC005
  usecase "UC006 Resolver exercício" as UC006
  usecase "UC007 Consultar progresso" as UC007
  usecase "UC011 Consultar ranking de XP" as UC011
  usecase "UC012 Consultar ajuda do exercício" as UC012
  usecase "UC028 Avaliar resposta" as UC028
  usecase "UC029 Executar código\ne testes" as UC029
 }
 package "Duelos e avaliação" {
  usecase "UC008 Criar duelo aberto" as UC008
  usecase "UC009 Entrar em duelo" as UC009
  usecase "UC010 Enviar solução de duelo" as UC010
  usecase "UC016 Avaliar empate técnico" as UC016
  usecase "UC024 Candidatar-se a avaliador" as UC024
  usecase "UC027 Aprovar ou rejeitar candidatura de avaliador" as UC027
 }
 package "Comunidade e administração" {
  usecase "UC013 Criar publicação" as UC013
  usecase "UC014 Interagir com publicação" as UC014
  usecase "UC015 Criar evento" as UC015
  usecase "UC023 Participar de evento" as UC023
  usecase "UC019 Gerenciar permissões de usuários" as UC019
  usecase "UC020 Tratar denúncias" as UC020
  usecase "UC021 Consultar notificações" as UC021
 }
 package "Vagas e empresas" {
  usecase "UC017 Publicar vaga" as UC017
  usecase "UC018 Consultar vagas" as UC018
  usecase "UC022 Candidatar-se a vaga" as UC022
  usecase "UC025 Cadastrar empresa" as UC025
  usecase "UC026 Atualizar etapa de candidatura" as UC026
 }
}
Visitante -- UC001
Visitante -- UC002
Auth -- UC001
Auth -- UC002
Usuario -- UC003
Usuario -- UC004
Usuario -- UC005
Usuario -- UC006
Usuario -- UC007
Usuario -- UC008
Usuario -- UC009
Usuario -- UC010
Usuario -- UC011
Usuario -- UC012
Usuario -- UC013
Usuario -- UC014
Usuario -- UC018
Usuario -- UC021
Usuario -- UC022
Usuario -- UC023
Usuario -- UC024
Runner -- UC029
Avaliador -- UC016
Administrador -- UC016
Administrador -- UC015
Administrador -- UC017
Administrador -- UC019
Administrador -- UC020
Administrador -- UC027
Recrutador -- UC015
Recrutador -- UC017
Usuario -- UC025
Recrutador -- UC026
Avaliador --|> Usuario
Administrador --|> Usuario
Recrutador --|> Usuario
UC006 ..> UC028 : <<include>>
UC010 ..> UC029 : <<include>>
UC029 ..> UC028 : <<extend>>\n[atividade de código]
UC012 ..> UC006 : <<extend>>\n[solicita ajuda e modo permite]
legend bottom
  Generalização: o triângulo vazado aponta para o ator geral.
  <<include>>: obrigatório; a seta aponta para o comportamento incluído.
  <<extend>>: condicionado; a seta aponta para o caso base.
  Pontos de extensão: UC006 consultar ajuda; UC028 avaliar código.
  Autenticação é pré-condição dos casos protegidos, não um include.
endlegend
@enduml
