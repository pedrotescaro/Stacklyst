  usecase "UC023 Participar de evento" as UC023
  usecase "UC019 Administrar papéis" as UC019
  usecase "UC020 Tratar denúncias" as UC020
  usecase "UC021 Consultar notificações" as UC021
}
Usuario -- UC013
Usuario -- UC014
Usuario -- UC021
